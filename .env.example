# Copy to .env and adjust. All values are also editable at runtime from the WebUI
# except the URLs and ports, which are read at startup.

# --- run mode ---
# all   : TTSサーバーもWebUIもこのMacで動かす（既定）
# webui : WebUIだけ。TTSは別マシン。下のURLを必ず設定すること
# tts   : TTSサーバーだけ。WebUIは別マシン
# ./run.sh --webui-only / --tts-only / --all で一時的に上書きできる。
AUTOSPEAK_MODE=all

# --- ports ---
# The shell scripts and the Python side both read these, so changing a port here
# is enough — run.sh, start_tts.sh and stop_tts.sh all follow.
AUTOSPEAK_HOST=0.0.0.0
AUTOSPEAK_PORT=8000
AUTOSPEAK_TTS_REF_PORT=8088
AUTOSPEAK_TTS_CAPTION_PORT=8089

# --- SearXNG ---
AUTOSPEAK_SEARXNG_URL=http://192.168.1.10:10000
AUTOSPEAK_SEARCH_RESULTS=6
AUTOSPEAK_SEARCH_FETCH_PAGES=3

# --- LM Studio ---
# 2-machine operation: LM Studio gets a machine to itself.
# Do NOT point this at 127.0.0.1 while a TTS server runs on the same 32GB Mac —
# the two together exhaust unified memory and TTS latency spikes past 100s.
AUTOSPEAK_LLM_URL=http://192.168.1.11:1234
# Pick a model LM Studio already has room for. Asking it to load a second large
# model on a 32GB Mac returns 400 "insufficient system resources".
AUTOSPEAK_LLM_MODEL=gemma-4-26b-a4b-it-mlx

# --- Irodori-TTS ---
# Leave these empty to use the local servers on the ports set above. Set them
# only to spread synthesis across other machines: comma-separated, one worker
# per endpoint. A single M1 Max already sustains continuous speech on its own.
#   AUTOSPEAK_TTS_REF_URLS=http://127.0.0.1:8088,http://192.168.1.13:8088
AUTOSPEAK_TTS_REF_URLS=
AUTOSPEAK_TTS_CAPTION_URLS=

# Measured on M1 Max: 24 steps = 2.8s per sentence, RTF 0.56.
AUTOSPEAK_TTS_NUM_STEPS=24

# --- pacing ---
AUTOSPEAK_PREFETCH_TURNS=4
AUTOSPEAK_PREFETCH_SECONDS=90
