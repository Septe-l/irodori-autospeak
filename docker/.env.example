# Copy to docker/.env. These are read by docker compose, not by the Mac's .env.
#
# Every address must be reachable FROM INSIDE THE CONTAINER.
# 127.0.0.1 would point at the container itself, so use real LAN addresses.

# Port published on the Docker host.
AUTOSPEAK_PORT=8000

AUTOSPEAK_SEARXNG_URL=http://192.168.1.10:10000
AUTOSPEAK_LLM_URL=http://192.168.1.11:1234
AUTOSPEAK_LLM_MODEL=gemma-4-26b-a4b-it-mlx

# Seeds the TTS endpoint list on first run. Afterwards edit it in the WebUI
# (設定 → TTSサーバー); the list lives in docker/data/settings.local.json.
#
# One TTS server (speaker is forced to solo):
#   AUTOSPEAK_TTS_REF_URLS=http://192.168.1.12:8088
#   AUTOSPEAK_TTS_CAPTION_URLS=
#
# Two servers on different machines (enables the two-speaker mode):
AUTOSPEAK_TTS_REF_URLS=http://192.168.1.11:8088
AUTOSPEAK_TTS_CAPTION_URLS=http://192.168.1.12:8089

AUTOSPEAK_TTS_NUM_STEPS=20
AUTOSPEAK_PREFETCH_TURNS=8
AUTOSPEAK_PREFETCH_SECONDS=240
